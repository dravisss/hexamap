{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexamap.local/schemas/project.schema.json",
  "title": "HexMap project configuration",
  "type": "object",
  "required": ["version", "id", "title", "notes", "manifest"],
  "properties": {
    "version": {"type": "string", "const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "notes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "manifest": {"type": "string", "const": ".hexmap/map.json"},
    "preset": {"type": "string"},
    "extensions": {"type": "object"}
  },
  "additionalProperties": false
}
